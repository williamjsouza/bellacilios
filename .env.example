# URL do Banco de Dados SQLite
# No Prisma com SQLite, o caminho "file:../db/custom.db" aponta para a pasta /db na raiz do projeto
DATABASE_URL="file:../db/custom.db"

# Porta da aplicação (padrão Next.js: 3000)
PORT=3000
NODE_ENV=production

# Chave secreta da sessão do NextAuth (gere um valor com: openssl rand -base64 32)
NEXTAUTH_SECRET="altere-este-segredo-super-seguro"

# URL pública da aplicação (opcional para NextAuth caso necessário)
# NEXTAUTH_URL="https://seu-dominio.com.br"

# Opcional: criar admin inicial pela rota de seed
# SEED_ADMIN_TOKEN="token-secreto"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="senha-forte"
